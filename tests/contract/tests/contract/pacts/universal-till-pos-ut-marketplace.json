{
  "consumer": {
    "name": "universal-till-pos"
  },
  "interactions": [
    {
      "description": "issue download token",
      "providerState": "plugin artifact is available",
      "request": {
        "body": {
          "device_arch": "amd64",
          "device_id": "device-1",
          "listing_id": "listing-123",
          "merchant_id": "merchant-1",
          "store_id": "store-1",
          "version": "1.2.3"
        },
        "headers": {
          "Authorization": "Bearer test-token",
          "Content-Type": "application/json",
          "x-marketplace-api-version": "1.0.0"
        },
        "matchingRules": {
          "$.body.device_arch": {
            "match": "type"
          },
          "$.body.device_id": {
            "match": "type"
          },
          "$.body.listing_id": {
            "match": "type"
          },
          "$.body.merchant_id": {
            "match": "type"
          },
          "$.body.store_id": {
            "match": "type"
          },
          "$.body.version": {
            "match": "type"
          }
        },
        "method": "POST",
        "path": "/v1/downloads/tokens"
      },
      "response": {
        "body": {
          "data": {
            "bundle_url": "/api/v1/downloads/artifact/listing-123",
            "checksum_sha256": "deadbeef",
            "expires_at": "2025-01-01T00:00:00Z",
            "release_id": "rel-123",
            "signature": "abc123",
            "token": "tok-abc",
            "version": "1.2.3"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.data.bundle_url": {
            "match": "type"
          },
          "$.body.data.checksum_sha256": {
            "match": "type"
          },
          "$.body.data.expires_at": {
            "match": "type"
          },
          "$.body.data.release_id": {
            "match": "type"
          },
          "$.body.data.signature": {
            "match": "type"
          },
          "$.body.data.token": {
            "match": "type"
          },
          "$.body.data.version": {
            "match": "type"
          }
        },
        "status": 200
      }
    },
    {
      "description": "list plugins",
      "providerState": "catalog has plugins",
      "request": {
        "headers": {
          "Authorization": "Bearer test-token",
          "x-marketplace-api-version": "1.0.0"
        },
        "method": "GET",
        "path": "/v1/catalog/plugins",
        "query": "arch=amd64&capability=payments&locale=en-US"
      },
      "response": {
        "body": {
          "pagination": {
            "has_next": false,
            "has_previous": false,
            "page": 1,
            "page_size": 20,
            "total_items": 1,
            "total_pages": 1
          },
          "plugins": [
            {
              "artifact_hash": "abc123",
              "artifact_url": "http://example.test/plugin.tgz",
              "canonical_type": "payment",
              "capabilities": [
                "payments"
              ],
              "description": "Payments plugin",
              "device_arch": "amd64",
              "id": "plugin-123",
              "listing_id": "listing-123",
              "name": "Sample Plugin",
              "trust_tier": "trusted",
              "version": "1.0.0"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.pagination.has_next": {
            "match": "type"
          },
          "$.body.pagination.has_previous": {
            "match": "type"
          },
          "$.body.pagination.page": {
            "match": "type"
          },
          "$.body.pagination.page_size": {
            "match": "type"
          },
          "$.body.pagination.total_items": {
            "match": "type"
          },
          "$.body.pagination.total_pages": {
            "match": "type"
          },
          "$.body.plugins": {
            "match": "type",
            "min": 1
          },
          "$.body.plugins[*].artifact_hash": {
            "match": "type"
          },
          "$.body.plugins[*].artifact_url": {
            "match": "type"
          },
          "$.body.plugins[*].canonical_type": {
            "match": "type"
          },
          "$.body.plugins[*].capabilities": {
            "match": "type",
            "min": 1
          },
          "$.body.plugins[*].capabilities[*]": {
            "match": "type"
          },
          "$.body.plugins[*].description": {
            "match": "type"
          },
          "$.body.plugins[*].device_arch": {
            "match": "type"
          },
          "$.body.plugins[*].id": {
            "match": "type"
          },
          "$.body.plugins[*].listing_id": {
            "match": "type"
          },
          "$.body.plugins[*].name": {
            "match": "type"
          },
          "$.body.plugins[*].trust_tier": {
            "match": "type"
          },
          "$.body.plugins[*].version": {
            "match": "type"
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-go": {
      "version": "2.4.2"
    },
    "pactRust": {
      "ffi": "0.4.23",
      "mockserver": "1.2.10",
      "models": "1.2.5"
    },
    "pactSpecification": {
      "version": "2.0.0"
    }
  },
  "provider": {
    "name": "ut-marketplace"
  }
}