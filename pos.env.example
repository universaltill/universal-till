# pos runtime
UT_LISTEN_ADDR=:8080
UT_DEFAULT_LOCALE=en
UT_STORE=sqlite
UT_SAMPLES_DIR=

# Money & tax
UT_CURRENCY=GBP
UT_TAX_INCLUSIVE=false
UT_TAX_RATE=20

# Marketplace integration (009-cloud-marketplace)
# Production/staging endpoint (default: local dev marketplace)
UT_MARKETPLACE_ENDPOINT_URL=http://127.0.0.1:8081/api

# Merchant id named in marketplace requests (enrolment fills it in).
# The till authenticates with its ADR-0116 device credential; there is no
# client secret (ut-docs#3577).
UT_MARKETPLACE_CLIENT_ID=

# API version pinning (semver format)
UT_MARKETPLACE_API_VERSION=1.0.0

# Dev-mode settings (only honored when UT_DEV_MODE=true)
UT_DEV_MODE=false
UT_MARKETPLACE_DEV_OVERRIDE_URL=

# Endpoint validation timeouts (seconds)
UT_MARKETPLACE_HEALTH_CHECK_TIMEOUT_SEC=5
UT_MARKETPLACE_FALLBACK_TIMEOUT_SEC=30



# Camera identify and "Ask your till" come from the AI Assistant plugin
# (Marketplace, version 2.0 or later), configured on its settings page.
# Background removal for item/category/variant photos works out of the box
# (built in, runs on the device; ut-docs#4137). Optional: point it at the
# shop's own rembg server instead. Empty = built-in; never on the checkout path.
#UT_AI_IMAGE_ENDPOINT=http://192.168.1.20:7000
#UT_AI_IMAGE_MODEL=birefnet-general-lite
