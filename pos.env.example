# pos runtime
UT_LISTEN_ADDR=:8080
UT_DEFAULT_LOCALE=en
UT_STORE=sqlite
UT_SAMPLES_DIR=

# Money & tax
UT_CURRENCY=GBP
UT_TAX_INCLUSIVE=false
UT_TAX_RATE=20

# Marketplace integration (009-cloud-marketplace)
# Production/staging endpoint (default: local dev marketplace)
UT_MARKETPLACE_ENDPOINT_URL=http://127.0.0.1:8081

# OAuth2 client credentials for marketplace authentication
# Leave empty for local dev; set for production/staging deployments
UT_MARKETPLACE_CLIENT_ID=
UT_MARKETPLACE_CLIENT_SECRET=

# API version pinning (semver format)
UT_MARKETPLACE_API_VERSION=1.0.0

# Telemetry opt-in (set to true to send usage data to marketplace)
UT_MARKETPLACE_TELEMETRY_OPT_IN=false

# Dev-mode settings (only honored when UT_DEV_MODE=true)
UT_DEV_MODE=false
UT_MARKETPLACE_DEV_OVERRIDE_URL=

# Endpoint validation timeouts (seconds)
UT_MARKETPLACE_HEALTH_CHECK_TIMEOUT_SEC=5
UT_MARKETPLACE_FALLBACK_TIMEOUT_SEC=30

