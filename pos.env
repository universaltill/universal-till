# Marketplace gRPC API documentation:
#   /Users/farshid/repos/unitill/ut-market-place/docs/marketplace.proto
#   /Users/farshid/repos/unitill/ut-market-place/docs/plugin_host.proto
UT_LISTEN_ADDR=:8080
UT_DEFAULT_LOCALE=en-US
UT_STORE=sqlite
UT_SAMPLES_DIR=
UT_CURRENCY=GBP
UT_TAX_INCLUSIVE=false
UT_TAX_RATE=20

# Marketplace Configuration (009-cloud-marketplace)
# For local testing with mock marketplace on port 8082
# For real marketplace, use https://127.0.0.1:8081/api or production URL
UT_MARKETPLACE_ENDPOINT_URL=https://127.0.0.1:8081/api
UT_MARKETPLACE_CLIENT_ID=pos-client # Used as merchant_id for JWT auth
UT_MARKETPLACE_CLIENT_SECRET=dev-secret # Used as device_id for JWT auth

# Optional: gRPC endpoint for marketplace integration
UT_MARKETPLACE_GRPC_URL=localhost:9090
UT_MARKETPLACE_API_VERSION=1.0.0
UT_MARKETPLACE_LOCALE=en-US
