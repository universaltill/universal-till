UT_LISTEN_ADDR=:8080
UT_DEFAULT_LOCALE=en-US
UT_STORE=sqlite
UT_SAMPLES_DIR=
UT_CURRENCY=GBP
UT_TAX_INCLUSIVE=false
UT_TAX_RATE=20

# Marketplace Configuration (009-cloud-marketplace)
# Points at the DEPLOYED dev marketplace in the homelab cluster. It runs with auth
# disabled, so no OAuth client secret / API key is needed. Change the URL (must
# include /api) + PUBLIC_KEY below to target a different marketplace.
UT_MARKETPLACE_ENDPOINT_URL=https://marketplace.home.taskrunnertech.co.uk/api

# Ed25519 public key the POS uses to verify plugin signatures. This is the live
# dev marketplace signing key (GET /ui/api/signing-key).
UT_MARKETPLACE_PUBLIC_KEY=581306fb77b04fdb045a7c6e7641fe93e4223a23ec1741d4dca8a683e7038229

# CLIENT_ID doubles as the marketplace merchant_id on the install path; STORE_ID
# is the store. merchant-1/store-1 matches the entitlement provisioned on the
# dev marketplace so one-click install of the FAQ plugin works out of the box.
UT_MARKETPLACE_CLIENT_ID=merchant-1
UT_MARKETPLACE_STORE_ID=store-1
UT_MARKETPLACE_DEVICE_ID=pos-device-1
UT_MARKETPLACE_API_VERSION=1.0.0
UT_MARKETPLACE_LOCALE=en-US
# Merchant portal token — only needed when the marketplace runs with auth
# enabled (the dev marketplace has AUTH_DISABLED=true, so leave unset).
# Issue one with: POST /ui/api/admin/merchants/portal-token (admin bearer).
#UT_MARKETPLACE_MERCHANT_TOKEN=

# Interface scale for the till screen (root font-size multiplier).
# 1 = default; 0.8 fits small 1024x600 touch screens; 1.3 for large displays.
UT_UI_SCALE=1


# Assistive AI (camera identify; docs repo: architecture/ai-integration.md).
# SELF-HOSTED FIRST: point UT_AI_ENDPOINT at an Ollama server running an open
# vision model — on a machine in the store, the homelab, or a VM you provide.
# Nothing configured = the feature is invisible; it is never on the checkout
# path (ADR-0003) — barcode scan stays primary.
#UT_AI_ENDPOINT=http://localhost:11434
#UT_AI_MODEL=llama3.2-vision
# Optional hosted alternative (explicit opt-in to a paid API):
#UT_AI_PROVIDER=claude
#UT_AI_API_KEY=
