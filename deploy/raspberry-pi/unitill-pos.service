# Universal Till POS — systemd unit for a dedicated till (Raspberry Pi).
# Installed by deploy/raspberry-pi/install.sh to /etc/systemd/system/.
[Unit]
Description=Universal Till POS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pos
WorkingDirectory=/opt/unitill
# pos.env carries UT_MARKETPLACE_* etc. (copy pos.env.dev and adjust)
EnvironmentFile=-/opt/unitill/pos.env
Environment=UT_KIOSK=1
Environment=UT_LISTEN_ADDR=127.0.0.1:8080
ExecStart=/opt/unitill/bin/unitill-pos
Restart=always
RestartSec=3

# The till keeps working without the network (offline-first); no network hard
# dependency beyond ordering.

[Install]
WantedBy=multi-user.target
