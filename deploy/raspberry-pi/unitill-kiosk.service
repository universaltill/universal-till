# Fullscreen kiosk browser pointed at the local POS.
# Works on Raspberry Pi OS with an X/Wayland desktop session for user "pos".
[Unit]
Description=Universal Till kiosk browser
After=graphical.target unitill-pos.service
Wants=unitill-pos.service

[Service]
User=pos
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
# Wait for the POS to answer before launching the browser.
ExecStartPre=/bin/sh -c 'until curl -sf http://127.0.0.1:8080/ >/dev/null; do sleep 1; done'
ExecStart=/usr/bin/chromium-browser \
  --kiosk http://127.0.0.1:8080/ \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-features=TranslateUI \
  --overscroll-history-navigation=0 \
  --check-for-update-interval=31536000 \
  --autoplay-policy=no-user-gesture-required
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
