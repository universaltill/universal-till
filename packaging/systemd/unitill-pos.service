# Universal Till POS — installed by the .deb package.
[Unit]
Description=Universal Till POS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pos
WorkingDirectory=/opt/unitill
# Pin the data dir: the pos system user has no per-user home, and this keeps
# the database where it already lives (persists across .deb upgrades).
Environment=UT_DATA_DIR=/opt/unitill/data
EnvironmentFile=-/opt/unitill/pos.env
ExecStart=/opt/unitill/bin/unitill-pos
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
