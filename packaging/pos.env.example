# Universal Till POS — configuration (systemd reads this via EnvironmentFile).
# Every value has a sensible default; uncomment to change.

# Where the till listens. 127.0.0.1 = this machine only (kiosk browser);
# use :8080 to reach it from other devices on the LAN.
#UT_LISTEN_ADDR=127.0.0.1:8080

# Data directory: database, backups, installed plugins, item images all live
# here. Defaults to a stable per-user location so data survives upgrades
# (macOS ~/Library/Application Support/UniversalTill, Windows %LOCALAPPDATA%,
# Linux ~/.local/share/universal-till). The .deb pins /opt/unitill/data.
#UT_DATA_DIR=
# Override just the database file if you want it elsewhere.
#UT_DB_PATH=

# Locale / currency / tax — the first-boot wizard sets these in the DB;
# env values are only the pre-wizard defaults.
#UT_DEFAULT_LOCALE=en-US
#UT_CURRENCY=GBP
#UT_TAX_RATE=20

# Interface scale for this screen: 0.8 fits 1024x600 panels, 1.3 large.
#UT_UI_SCALE=1

# Marketplace (plugin store). Defaults to the official Universal Till
# marketplace so the Plugin Store is populated out of the box. Point it at your
# own marketplace, or comment it out to run fully standalone (no plugin store).
# Sales always work offline regardless of this setting.
UT_MARKETPLACE_ENDPOINT_URL=https://marketplace.universaltill.com/api
# The marketplace's Ed25519 public key — required to VERIFY and install signed
# plugins. Browsing the catalog works without it.
#UT_MARKETPLACE_PUBLIC_KEY=
#UT_MARKETPLACE_CLIENT_ID=
#UT_MARKETPLACE_STORE_ID=
#UT_MARKETPLACE_DEVICE_ID=

# Assistive AI (optional, self-hosted). Point at an Ollama server.
#UT_AI_ENDPOINT=http://localhost:11434
#UT_AI_MODEL=llama3.2-vision
#UT_AI_ASK_MODEL=llama3.2
