<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The WebView talks to the till server over loopback HTTP (see
         network_security_config.xml — cleartext is allowed ONLY for
         127.0.0.1, not globally). INTERNET is still required: Android's
         WebView routes all HTTP traffic through the normal network stack
         even for loopback destinations. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- TillService (ADR-0023 §1's foreground-service packaging shape)
         keeps the embedded server running independent of MainActivity's
         own lifecycle. FOREGROUND_SERVICE + the SPECIAL_USE subtype are
         required to start any foreground service at all on modern
         Android; POST_NOTIFICATIONS (API 33+) is requested at runtime in
         MainActivity, best-effort — the service still runs even if it's
         denied, same "never block the core function on a secondary
         permission" posture as the rest of this till. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ut-docs#1246: in-app update. The Go core ships as a native library
         inside this APK, so it can never self-swap the way the desktop/Pi
         builds do — only the package installer may replace an app's own code.
         This permission lets MainActivity hand a downloaded release APK to
         that installer, turning "go and download a new APK by hand for every
         build" into one tap. Android still enforces that the new APK carries
         the SAME signing key, so this cannot be used to install a substituted
         package over this one. NOTE for the Play build: Play restricts
         REQUEST_INSTALL_PACKAGES and does its own updating, so a Play-targeted
         variant should drop this permission and the bridge behind it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- ut-docs#1435: back the WebView's getUserMedia() (the bug-report
         panel's voice note today; in-page camera capture as a follow-up).
         Both are dangerous permissions, requested at runtime by
         MainActivity's WebChromeClient.onPermissionRequest — lazily, only
         when a page actually starts a capture, never at boot — and only
         for the till's own loopback origin. Deliberately NO matching
         <uses-feature android:name="android.hardware.camera"> here: a till
         may run on hardware without any camera, and declaring the feature
         would make the app uninstallable there; the runtime check is
         what decides, never an assumption that a camera exists. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- MODIFY_AUDIO_SETTINGS is normal (auto-granted), needed by the
         WebView's audio-capture path for route/gain setup during a
         getUserMedia({audio}) session. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
        <!-- ut-docs#1246: grants the system installer read access to the
             downloaded APK. A file:// URI is rejected outright from API 24
             (FileUriExposedException) — this app's own minSdk — so the
             content:// grant is the only route, not a modern-Android nicety.
             Scoped to the app's external files dir (res/xml/file_paths.xml),
             never the shared Downloads collection. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <!-- The server surviving rotation (TillService) is only half the
                 fix — without this, the DEFAULT Android behavior still
                 destroys and recreates the Activity (and its WebView) on
                 every rotation, discarding in-page/scroll state and forcing
                 a visible reload even though the server never restarted.
                 Declaring these configChanges makes the Activity handle
                 rotation itself instead (no recreation at all), so the
                 WebView instance — and MainActivity's listener's
                 reload-avoidance check — actually do what their comments
                 claim. Independent review, 2026-07-25, traced through why
                 the reload-avoidance check was previously inert without
                 this. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".TillService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the till's own embedded POS server so it survives screen rotation and backgrounding" />
        </service>

        <!-- ut-docs#414 (independent review, 2026-08-07): opts into
             AndroidX's per-app-language auto-storage on API 24-32
             (AppCompatDelegate.isAutoStorageOptedIn checks for exactly
             this service declaration + meta-data before persisting
             anything). Without it, MainActivity's locale-sync logic
             re-applied the till's locale via setApplicationLocales() on
             EVERY cold launch — even into English, even when nothing
             changed — because nothing survived a process restart to
             compare against, forcing an extra Activity recreate (and a
             visible reload of the WebView) on every single app start, not
             just on a genuine language change. This service is never
             started; AndroidX only reads its manifest metadata. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- ut-docs#1254: inert scaffolding until a device is actually
             provisioned as Device Owner (a manual, physical, out-of-band
             step — see android/README.md, "Kiosk lock-down"). It exists so
             `dpm set-device-owner` CAN target this app at all; on every
             unprovisioned device (today's reality) it is never invoked and
             MainActivity falls back to plain screen-pinning. The
             BIND_DEVICE_ADMIN permission restricts who may bind/deliver to
             it (the system only), which is why exported="true" is safe and
             required here. -->
        <receiver
            android:name=".TillDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
