<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The WebView talks to the till server over loopback HTTP (see
         network_security_config.xml — cleartext is allowed ONLY for
         127.0.0.1, not globally). INTERNET is still required: Android's
         WebView routes all HTTP traffic through the normal network stack
         even for loopback destinations. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- TillService (ADR-0023 §1's foreground-service packaging shape)
         keeps the embedded server running independent of MainActivity's
         own lifecycle. FOREGROUND_SERVICE + the SPECIAL_USE subtype are
         required to start any foreground service at all on modern
         Android; POST_NOTIFICATIONS (API 33+) is requested at runtime in
         MainActivity, best-effort — the service still runs even if it's
         denied, same "never block the core function on a secondary
         permission" posture as the rest of this till. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ut-docs#1246: in-app update. The Go core ships as a native library
         inside this APK, so it can never self-swap the way the desktop/Pi
         builds do — only the package installer may replace an app's own code.
         This permission lets MainActivity hand a downloaded release APK to
         that installer, turning "go and download a new APK by hand for every
         build" into one tap. Android still enforces that the new APK carries
         the SAME signing key, so this cannot be used to install a substituted
         package over this one. NOTE for the Play build: Play restricts
         REQUEST_INSTALL_PACKAGES and does its own updating, so a Play-targeted
         variant should drop this permission and the bridge behind it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- ut-docs#1435: back the WebView's getUserMedia() (the bug-report
         panel's voice note today; in-page camera capture as a follow-up).
         Both are dangerous permissions, requested at runtime by
         MainActivity's WebChromeClient.onPermissionRequest — lazily, only
         when a page actually starts a capture, never at boot — and only
         for the till's own loopback origin. A till may run on hardware
         without a camera or a microphone, so both stay installable there:
         CAMERA and RECORD_AUDIO are on Android's "permissions that imply
         feature requirements" list (ut-docs#1770, same bug already fixed
         for the Bluetooth permissions below in ut-docs#1751) — omitting
         the matching <uses-feature required="false"> makes the store
         DERIVE the feature as required="true", the opposite of the
         intent. The runtime permission check above is what decides
         whether the hardware is actually used, never an assumption that
         it exists. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- ut-docs#1751: the Bluetooth devices page. WITHOUT these the app is
         refused by Android no matter what the Kotlin bridge does — which is
         half of why the page listed nothing on a tablet whose Bluetooth was
         demonstrably switched on. minSdk here is 24, so BOTH permission
         regimes are live in the field and both have to be declared:
         API 31+ splits Bluetooth into runtime-granted BLUETOOTH_SCAN
         (discover) and BLUETOOTH_CONNECT (read a bonded device's name, bond
         with it); API 30 and below instead auto-grants BLUETOOTH/
         BLUETOOTH_ADMIN at install and gates scan RESULTS behind location,
         hence ACCESS_FINE_LOCATION there and only there. neverForLocation
         states the truth that this till never derives location from a scan,
         which is also why FINE_LOCATION carries maxSdkVersion="30" rather
         than being requested on modern Android at all.
         The <uses-feature required="false"> below is REQUIRED to stay
         installable on radio-less hardware, and reasoning it away was
         backwards (review finding, ut-docs#1751): BLUETOOTH,
         BLUETOOTH_ADMIN, BLUETOOTH_SCAN and BLUETOOTH_CONNECT are all on
         Android's "permissions that imply feature requirements" list, so
         OMITTING the element makes the store derive
         android.hardware.bluetooth required="TRUE" — the exact opposite of
         the intent. Only an explicit required="false" says "use it if the
         hardware has it". Sideloaded installs never cared either way; store
         distribution does. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- ut-docs#1770: ACCESS_FINE_LOCATION is ALSO on the implied-feature
         list — it derives both android.hardware.location and
         android.hardware.location.gps. It is declared here purely to
         unlock pre-API-31 Bluetooth scan results (see the comment above;
         neverForLocation on BLUETOOTH_SCAN already states this till never
         reads real location from either path), not because the till has
         or needs a GPS/location radio, so both derived features must stay
         required="false" for the same reason as the camera/microphone/
         Bluetooth ones above. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- MODIFY_AUDIO_SETTINGS is normal (auto-granted), needed by the
         WebView's audio-capture path for route/gain setup during a
         getUserMedia({audio}) session. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
        <!-- ut-docs#1246: grants the system installer read access to the
             downloaded APK. A file:// URI is rejected outright from API 24
             (FileUriExposedException) — this app's own minSdk — so the
             content:// grant is the only route, not a modern-Android nicety.
             Scoped to the app's external files dir (res/xml/file_paths.xml),
             never the shared Downloads collection. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <!-- The server surviving rotation (TillService) is only half the
                 fix — without this, the DEFAULT Android behavior still
                 destroys and recreates the Activity (and its WebView) on
                 every rotation, discarding in-page/scroll state and forcing
                 a visible reload even though the server never restarted.
                 Declaring these configChanges makes the Activity handle
                 rotation itself instead (no recreation at all), so the
                 WebView instance — and MainActivity's listener's
                 reload-avoidance check — actually do what their comments
                 claim. Independent review, 2026-07-25, traced through why
                 the reload-avoidance check was previously inert without
                 this. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".TillService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the till's own embedded POS server so it survives screen rotation and backgrounding" />
        </service>

        <!-- ut-docs#414 (independent review, 2026-08-07): opts into
             AndroidX's per-app-language auto-storage on API 24-32
             (AppCompatDelegate.isAutoStorageOptedIn checks for exactly
             this service declaration + meta-data before persisting
             anything). Without it, MainActivity's locale-sync logic
             re-applied the till's locale via setApplicationLocales() on
             EVERY cold launch — even into English, even when nothing
             changed — because nothing survived a process restart to
             compare against, forcing an extra Activity recreate (and a
             visible reload of the WebView) on every single app start, not
             just on a genuine language change. This service is never
             started; AndroidX only reads its manifest metadata. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- ut-docs#1254: inert scaffolding until a device is actually
             provisioned as Device Owner (a manual, physical, out-of-band
             step — see android/README.md, "Kiosk lock-down"). It exists so
             `dpm set-device-owner` CAN target this app at all; on every
             unprovisioned device (today's reality) it is never invoked and
             MainActivity falls back to plain screen-pinning. The
             BIND_DEVICE_ADMIN permission restricts who may bind/deliver to
             it (the system only), which is why exported="true" is safe and
             required here. -->
        <receiver
            android:name=".TillDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
