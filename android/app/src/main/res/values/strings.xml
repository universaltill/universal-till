<resources>
    <string name="app_name">Universal Till</string>
    <string name="status_starting">Starting the till…</string>
    <string name="status_running">Running at %1$s</string>
    <string name="status_failed">Failed to start: %1$s</string>
    <!-- ut-docs#412: the foreground-service notification must convey that
         the till is running without exposing the internal loopback
         address — status_running (above) still carries the address for
         the debug-only on-screen bar (MainActivity, BuildConfig.DEBUG). -->
    <string name="notification_running">Universal Till is running</string>
    <string name="notification_channel_name">Universal Till service</string>
    <!-- ut-docs#1639: shown on the self-order kiosk screen when Android's
         screen-pinning confirmation was never granted (unanswered or
         declined), so the till looks locked but isn't. -->
    <string name="kiosk_pin_not_engaged">Kiosk lock is not active — this device is not secured</string>
    <!-- ut-docs#1647: the external-link hand-off (MainActivity.openInSystemBrowser)
         can fail on a device with no browser app; the operator has to be told,
         otherwise the tap looks exactly like the silent no-op this ticket fixed. -->
    <string name="external_link_failed">Couldn’t open the link in a browser.</string>
    <!-- ut-docs#1751 (review finding): under screen pinning, Android blocks
         startActivity into another package with no exception at all, so the
         page's "Open Bluetooth settings" button would be a silent no-op —
         precisely the dead end this card exists to remove. -->
    <string name="bluetooth_settings_blocked_in_lockdown">Exit lockdown first — Android’s Bluetooth settings can’t open while the till is locked.</string>
    <!-- ut-docs#1457 (split from #1455 item 4): shown by MainActivity's
         error_bar when a main-frame WebView load fails before it ever
         reaches httpx.RenderError's translated error page (server not up
         yet, a network blip mid-navigation) — so this can't reuse that
         page's own strings and needs its own. -->
    <string name="error_bar_message">This page couldn’t load.</string>
    <string name="error_bar_action">Back to till</string>
</resources>
