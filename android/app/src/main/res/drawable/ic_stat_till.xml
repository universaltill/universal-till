<?xml version="1.0" encoding="utf-8"?>
<!-- Notification status-bar icon. Android requires these to be a flat
     white silhouette on a transparent background (the OS tints it itself,
     ignoring color) — the full-color launcher icon (unitill-logo.svg) would
     render as a solid white blob, so this is a small, purpose-built glyph
     instead, not a shrunk copy of the real logo. A simple till/register
     shape: body + a coin slot, echoing the real logo's register icon. -->
